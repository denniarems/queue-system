  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Flow (Happy Path)",
      "items": [
        "API Request validates payload and claims an atomic Redis idempotency lease (ADR 0002)",
        "Job is enqueued to dedicated per-gateway BullMQ queue with numeric priority (1: high, 2: normal, 3: low)",
        "Worker executes 3-step saga: reserve funds -> Gateway Guard call -> settle ledger",
        "Gateway Guard feeds outcome to rate limiter (AIMD) and updates circuit breaker",
        "Terminal state COMPLETED persisted and emitted to WebSocket stream"
      ]
    },
    {
      "dot": "amber",
      "title": "Gateway Guard & Resilience",
      "items": [
        "Gateway Guard acts as single seam: sequences token wait, breaker gate, and provider call",
        "Adaptive Token Bucket enforces throughput limits with AIMD backoff on 429/503",
        "Circuit Breaker samples failure rates in sliding window; fast-fails when OPEN",
        "Transient errors trigger BullMQ exponential backoff + jitter retry loop"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure Recovery & DLQ",
      "items": [
        "Permanent declines (card declined, fraud) skip retries and route directly to DLQ",
        "Settle failure triggers automated compensation: charge refund + fund release",
        "Critical alert raised if compensation refund fails",
        "Jobs exhausting max retries are routed to terminal dead-letter queue"
      ]
    },
    {
      "dot": "cyan",
      "title": "Observability & Telemetry",
      "items": [
        "Correlation ID propagated across HTTP headers, BullMQ jobs, and gateway calls",
        "OpenTelemetry spans track enqueue, process, reserve, charge, settle, and DLQ",
        "Redis immutable audit log and settlement ledger provide full financial traceability",
        "MetricsCollector computes 60s rolling TPS, P95/P99 latencies, and queue depths"
      ]
    }
  ]
