  "cards": [
    {
      "dot": "cyan",
      "title": "Ingress & Deduplication",
      "items": [
        "API clients submit requests with correlation and idempotency keys",
        "Two-phase Redis lease prevents duplicate payment processing",
        "Queue Manager dynamically routes to per-gateway BullMQ queues"
      ]
    },
    {
      "dot": "emerald",
      "title": "Saga Orchestration & Resilience",
      "items": [
        "Workers coordinate 3-step saga: Reserve -> Charge -> Settle & Audit",
        "Adaptive Token Bucket throttles throughput with AIMD backoff",
        "Circuit breaker trips to OPEN on sustained provider errors",
        "Unrecoverable or retry-exhausted payments divert to DLQ"
      ]
    },
    {
      "dot": "violet",
      "title": "Live Observability",
      "items": [
        "In-memory rolling window computes real-time TPS and P95/P99 latency",
        "Socket.IO gateway broadcasts live metrics and operational alerts"
      ]
